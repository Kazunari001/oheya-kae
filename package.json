{
  "name": "oheya-kae",
  "version": "0.1.0",
  "description": "AI-friendly room layout CLI and offline Three.js viewer",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kazunari001/oheya-kae.git"
  },
  "homepage": "https://github.com/Kazunari001/oheya-kae#readme",
  "bugs": "https://github.com/Kazunari001/oheya-kae/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin/",
    "src/",
    "dist/viewer.js",
    "dist/THREE-LICENSE.txt",
    "viewer/index.html",
    "viewer/viewer.css",
    "docs/",
    "assets/readme/demo.png"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "oheya-kae": "./bin/oheya-kae.js"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "oheya-kae": "node bin/oheya-kae.js",
    "build": "node scripts/build.js",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test",
    "test:browser": "node scripts/browser-check.js",
    "pretest:package": "npm run build",
    "test:package": "node scripts/package-check.js",
    "demo": "node scripts/demo.js"
  },
  "dependencies": {
    "commander": "14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "esbuild": "0.25.10",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "playwright": "1.56.1",
    "three": "0.180.0"
  }
}
